# CLARIO Environment Configuration Example
# Phase 0 Configuration
# Copy this file to .env and fill in your keys. Never commit real keys.

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider API Keys (Fallback Order: Gemini -> Groq -> OpenRouter -> Mistral)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini
MISTRAL_MODEL=mistral-large-latest

# Research Provider (Nova agent only)
TAVILY_API_KEY=

# LangSmith tracing (optional; enable only after adding your API key)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=False
LANGSMITH_PROJECT=clario
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Database Paths (SQLite - Exactly 3 separate database files)
USER_DB_PATH=backend/data/user.db
NOVA_DB_PATH=backend/data/nova.db
CLARIO_AI_DB_PATH=backend/data/clario_ai.db
